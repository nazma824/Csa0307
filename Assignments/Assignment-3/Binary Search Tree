#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int key;
    struct Node *left, *right;
} Node;

Node *make(int k) {
    Node *n = malloc(sizeof *n);
    if (!n) exit(1);
    n->key = k;
    n->left = n->right = NULL;
    return n;
}

Node *insert(Node *r, int k) {
    if (!r) return make(k);
    if (k < r->key) r->left = insert(r->left, k);
    else if (k > r->key) r->right = insert(r->right, k);
    return r;
}

int height(Node *r) {
    if (!r) return -1;
    int a = height(r->left);
    int b = height(r->right);
    return 1 + (a > b ? a : b);
}

void preorder(Node *r) {
    if (r) {
        printf("%d ", r->key);
        preorder(r->left);
        preorder(r->right);
    }
}

void inorder(Node *r) {
    if (r) {
        inorder(r->left);
        printf("%d ", r->key);
        inorder(r->right);
    }
}

void postorder(Node *r) {
    if (r) {
        postorder(r->left);
        postorder(r->right);
        printf("%d ", r->key);
    }
}

int main() {
    Node *root = NULL;
    int a[] = {50, 30, 70, 20, 40, 60, 80};

    for (int i = 0; i < 7; i++)
        root = insert(root, a[i]);

    printf("Preorder: ");
    preorder(root);

    printf("\nInorder: ");
    inorder(root);

    printf("\nPostorder: ");
    postorder(root);

    printf("\nHeight: %d\n", height(root));

    return 0;
}
